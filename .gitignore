# Raw data and per-capture spectra stay local at every directory depth.
# Existing committed reference fixtures are retained; new data is ignored.
*.tdms
*.tdms_index
data/
spectra/
per_run_fft/
*.npz

# Keep results/, analysis_results/ and validation_results/ reviewable.
# Full-resolution spectral workspaces, figures and CSV arrays are reproducible.
*.mat
*.fig
*FullResolution.csv
history/PXI-5922/results/**/average_noise_asd.csv

# Python environments, bytecode and incomplete pipeline outputs
.venv/
venv/
.venv-field/
.venv-postprocess/
.venv-thermal/
node_modules/
__pycache__/
*.py[cod]
.ipynb_checkpoints/
*.partial.*

# Keep legacy machine-local preferences/certificates out of future commits.
/.codex-matlab-*/
/MathWorks/

# Local review/render scratch files
/tmp/

# Common local/editor files
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.log

# Build caches and machine-local scratch; source/firmware archives stay versioned.
/fpga/local_cache/
/fpga/db/
/fpga/incremental_db/
/fpga/greybox_tmp/
/fpga/*.qws
/lfs/

# Keep the five existing OPA189 reference fixtures after their relocation.
!/history/OPA189/data/
/history/OPA189/data/*
!/history/OPA189/data/processed/
/history/OPA189/data/processed/*
!/history/OPA189/data/processed/formal_test/
/history/OPA189/data/processed/formal_test/*
!/history/OPA189/data/processed/formal_test/opa189_four_condition_analysis.mat
!/history/OPA189/data/processed/formal_test/opa189_four_condition_summary.csv
!/history/OPA189/data/processed/formal_test/opa189_four_condition_run_summary.csv
!/history/OPA189/data/processed/formal_test/opa189_four_condition_0p1_to_100hz.png
!/history/OPA189/data/processed/formal_test/opa189_with_shield_voltage_comparison_0p1_to_100hz.png
